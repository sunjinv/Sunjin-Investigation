rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ops.yu@sunjinv.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'lastLogin']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['category', 'date', 'timeSlot', 'status', 'notes', 'createdAt', 'name', 'contact']) &&
             (!data.keys().contains('userId') || data.userId == null || (isSignedIn() && data.userId == request.auth.uid)) &&
             data.category in ['이혼·가사 조사', '소송·증거 조사', 'TSCM 및 포렌식', '실종·소재 파악', '기업 리스크·보안'] &&
             data.date is string && data.date.size() == 10 &&
             data.timeSlot is string && data.timeSlot.size() <= 10 &&
             data.status in ['PENDING', 'CONFIRMED', 'COMPLETED', 'CANCELLED'] &&
             data.notes is string && data.notes.size() <= 2000 &&
             data.name is string && data.name.size() <= 100 &&
             data.contact is string && data.contact.size() <= 100;
    }

    // --- Matches ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLogin'])) ||
        isAdmin()
      );
    }

    match /reservations/{reservationId} {
      allow get: if (resource.data.get('userId', null) != null && isOwner(resource.data.userId)) || isAdmin();
      allow list: if true; // Publicly allow listing to check availability.
      allow create: if isValidId(reservationId) && isValidReservation(incoming());
      allow update: if (isAdmin() || (isSignedIn() && existing().get('userId', null) == request.auth.uid && existing().status == 'PENDING' && incoming().status == 'PENDING')) &&
                    isValidReservation(incoming()) &&
                    (incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'category', 'date', 'timeSlot', 'status']) || isAdmin());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
  }
}
